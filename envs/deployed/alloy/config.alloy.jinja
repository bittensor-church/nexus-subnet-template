// Grafana Alloy configuration for the validator's distributed traces.
//
// The upstream (TRACES_UPSTREAM_URL) is meant to be the observability proxy,
// mirroring how metrics already flow prometheus -> prometheus-proxy ->
// prometheus.bactensor.io. The proxy authenticates the operator and adds the
// `hotkey` label itself — which is why the validator never sends a hotkey. You
// can also point TRACES_UPSTREAM_URL straight at a Tempo backend (or any other
// OTLP-compatible upstream) instead.

otelcol.receiver.otlp "default" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces = [otelcol.processor.tail_sampling.traces.input]
	}
}

otelcol.processor.tail_sampling "traces" {
	decision_wait               = "30s"
	num_traces                  = 100000
	expected_new_traces_per_sec = 100
	// Alloy v1.15.1 `validate` reports `expected object, got object` for this
	// attribute, but `run` accepts it and cache-hit metrics confirm it works.
	decision_cache = {
		sampled_cache_size     = 1000000,
		non_sampled_cache_size = 1000000,
	}

	// Drop scrape/health noise so tail-sampling memory stays on real traffic.
	policy {
		name = "drop-noise-http"
		type = "drop"

		drop {
			drop_sub_policy {
				name = "noise-http-route"
				type = "string_attribute"

				string_attribute {
					key                    = "http.route"
					values                 = ["^/?(alive|health|metrics)/?$"]
					enabled_regex_matching = true
					cache_max_size         = 256
				}
			}
		}
	}

	policy {
		name = "keep-errors"
		type = "status_code"

		status_code {
			status_codes = ["ERROR"]
		}
	}

	policy {
		name = "keep-http-5xx-response"
		type = "numeric_attribute"

		numeric_attribute {
			key       = "http.response.status_code"
			min_value = 500
			max_value = 599
		}
	}

	policy {
		name = "keep-http-5xx-legacy"
		type = "numeric_attribute"

		numeric_attribute {
			key       = "http.status_code"
			min_value = 500
			max_value = 599
		}
	}

	policy {
		name = "keep-slow-traces"
		type = "latency"

		latency {
			threshold_ms = 1000
		}
	}

	policy {
		name = "keep-mutating-http-request-method"
		type = "string_attribute"

		string_attribute {
			key    = "http.request.method"
			values = ["POST", "PUT", "PATCH", "DELETE"]
		}
	}

	policy {
		name = "keep-mutating-http-method"
		type = "string_attribute"

		string_attribute {
			key    = "http.method"
			values = ["POST", "PUT", "PATCH", "DELETE"]
		}
	}

	policy {
		name = "baseline"
		type = "probabilistic"

		probabilistic {
			sampling_percentage = 5
			hash_salt           = "{{ subnet_slug }}-tail-sampling"
		}
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		traces = [otelcol.exporter.otlphttp.traces_upstream.input]
	}
}

otelcol.auth.basic "traces_upstream" {
	username = sys.env("TRACES_UPSTREAM_USER")
	password = sys.env("TRACES_UPSTREAM_PASSWORD")
}

otelcol.exporter.otlphttp "traces_upstream" {
	client {
		endpoint = sys.env("TRACES_UPSTREAM_URL")
		auth     = otelcol.auth.basic.traces_upstream.handler
	}
}
