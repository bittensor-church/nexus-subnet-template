name: Build validator image

on:
  push:
    branches:
      - 'deploy-build-*'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    env:
      IMAGE: {{ image_registry }}/{{ github_org | lower }}/{{ image_basename }}
    steps:
      # Hosted runner images can lag behind CA store fixes (emSign distrust, Oct 2026).
      - name: Upgrade runner CA certificates
        run: |
          sudo apt-get update
          sudo apt-get install -y --only-upgrade ca-certificates

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
{% raw %}
      - name: Determine environment from branch
        run: |
          set -e
          BRANCH="${GITHUB_REF_NAME}"
          if [[ "$BRANCH" != deploy-build-* ]]; then
            echo "Unsupported branch: $BRANCH" >&2
            exit 1
          fi
          echo "ENVIRONMENT=${BRANCH#deploy-build-}" >> "$GITHUB_ENV"

{% endraw %}
      - name: Log in to container registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: {{ image_registry }}
{% if image_registry == "ghcr.io" %}
          username: {{ '${{ github.actor }}' }}
          password: {{ '${{ secrets.GITHUB_TOKEN }}' }}
{% else %}
          username: {{ '${{ secrets.REGISTRY_USERNAME }}' }}
          password: {{ '${{ secrets.REGISTRY_PASSWORD }}' }}
{% endif %}
{% raw %}
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: image=docker.io/moby/buildkit@sha256:aa632b921ef07411d2cb77292cd34213d4f7b384001d6fceef1e1f25bf9752bb # v0.35.0

      - name: Build and push
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: ./validator
          file: ./validator/Dockerfile
          platforms: linux/amd64
          push: true
          tags: |
            ${{ env.IMAGE }}-${{ env.ENVIRONMENT }}:v0-latest
            ${{ env.IMAGE }}-${{ env.ENVIRONMENT }}:sha-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{% endraw %}
