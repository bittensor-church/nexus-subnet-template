#!/usr/bin/env bash
# Pulls envs/deployed/docker-compose.yml and the Alloy traces config from one
# revision of the deploy-config-${ENV_NAME} branch and restarts the {{ subnet_name }}
# validator stack if anything changed.

set -euo pipefail

# ENV_NAME is both the deploy-config branch suffix (deploy-config-${ENV_NAME}) and the
# OpenTelemetry deployment.environment.name attribute backfilled into .env below.
ENV_NAME="${1:-production}"
WORKING_DIRECTORY="${2:-$HOME/{{ working_dir_name }}/}"

mkdir -p "${WORKING_DIRECTORY}"
cd "${WORKING_DIRECTORY}"

ENV_FILE="${WORKING_DIRECTORY}/.env"
# Backfill settings that installations created by older installers lack.
if [ -f "${ENV_FILE}" ]; then
    if ! grep -q '^ENVIRONMENT=' "${ENV_FILE}"; then
        echo "ENVIRONMENT=${ENV_NAME}" >> "${ENV_FILE}"
    fi
    if ! grep -q '^VALIDATOR_PYLON_IDENTITY_TOKEN=' "${ENV_FILE}"; then
        echo "VALIDATOR_PYLON_IDENTITY_TOKEN=$(openssl rand -hex 32)" >> "${ENV_FILE}"
    fi
    if ! grep -q '^BITTENSOR_ARCHIVE_NETWORK=' "${ENV_FILE}"; then
        NETWORK="$(sed -n 's/^BITTENSOR_NETWORK=//p' "${ENV_FILE}" | tail -n 1)"
        if [ "${NETWORK}" = "finney" ]; then
            echo "BITTENSOR_ARCHIVE_NETWORK=archive" >> "${ENV_FILE}"
        else
            echo "BITTENSOR_ARCHIVE_NETWORK=${NETWORK}" >> "${ENV_FILE}"
        fi
    fi
fi

# Resolve the branch to one commit so every file comes from the same revision;
# raw.githubusercontent.com caches branch paths per file.
BRANCH="deploy-config-${ENV_NAME}"
if ! REVISION="$(curl -fsSL -H "Accept: application/vnd.github.sha" \
    "https://api.github.com/repos/{{ github_org }}/{{ github_repo }}/commits/${BRANCH}")"; then
    echo "Error: failed to resolve ${BRANCH}. Aborting update."
    exit 1
fi
if ! [[ "${REVISION}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Error: unexpected revision for ${BRANCH}: ${REVISION}. Aborting update."
    exit 1
fi
echo "Using ${BRANCH} at ${REVISION}"
BRANCH_URL="https://raw.githubusercontent.com/{{ github_org }}/{{ github_repo }}/${REVISION}"

UPDATED=false

TEMP_FILES=()
cleanup() {
    if [ "{% raw %}${#TEMP_FILES[@]}{% endraw %}" -gt 0 ]; then
        rm -f "${TEMP_FILES[@]}"
    fi
}
trap cleanup EXIT

# fetch_file <remote-path> <temp-file>: all downloads must succeed before any
# local files are replaced, so fetching and applying are kept separate.
fetch_file() {
    local remote_path="$1"
    local temp_file="$2"
    if ! curl -fsSL "${BRANCH_URL}/${remote_path}" > "${temp_file}"; then
        echo "Error: failed to fetch ${remote_path}. Aborting update."
        return 1
    fi
}

# apply_file <temp-file> <local-path>: replace the local copy and flag an update if it changed.
apply_file() {
    local temp_file="$1"
    local local_path="$2"
    mkdir -p "$(dirname "${local_path}")"
    if [ ! -f "${local_path}" ]; then
        echo "Local ${local_path} does not exist. Creating it."
        cat "${temp_file}" > "${local_path}"
        UPDATED=true
    elif diff -q "${temp_file}" "${local_path}" > /dev/null; then
        echo "No changes detected in ${local_path}"
    else
        echo "Changes detected in ${local_path}. Updating..."
        cat "${temp_file}" > "${local_path}"
        UPDATED=true
    fi
}

COMPOSE_TEMP="$(mktemp "${TMPDIR:-/tmp}/{{ subnet_slug }}_update.XXXXXX")"
TEMP_FILES+=("${COMPOSE_TEMP}")
ALLOY_TEMP="$(mktemp "${TMPDIR:-/tmp}/{{ subnet_slug }}_update.XXXXXX")"
TEMP_FILES+=("${ALLOY_TEMP}")

fetch_file "envs/deployed/docker-compose.yml" "${COMPOSE_TEMP}"
fetch_file "envs/deployed/alloy/config.alloy" "${ALLOY_TEMP}"

apply_file "${COMPOSE_TEMP}" "${WORKING_DIRECTORY}/docker-compose.yml"
apply_file "${ALLOY_TEMP}" "${WORKING_DIRECTORY}/alloy/config.alloy"

if [ "${UPDATED}" = true ]; then
    echo "Updating services..."

    if command -v docker &> /dev/null && docker compose version &> /dev/null; then
        docker compose up -d --remove-orphans
    elif command -v docker-compose &> /dev/null; then
        docker-compose up -d --remove-orphans
    else
        echo "Error: Neither docker compose nor docker-compose is available."
        exit 1
    fi

    echo "Services updated successfully."
fi

echo "Update process completed."
